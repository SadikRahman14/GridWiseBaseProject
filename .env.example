# Local, key-free generative model. Install Ollama and pull this model first.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# Alternative: an OpenAI-compatible Chat Completions provider.
# Replace the three LLM values above; do not define duplicate active variables.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=YOUR_PROVIDER_MODEL_ID
# LLM_API_KEY=YOUR_PRIVATE_KEY

# Total model budget INCLUDING retries. Must be <=25 seconds.
LLM_TIMEOUT_SECONDS=22
LLM_RETRIES=1
PORT=8000
